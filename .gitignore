# Secrets — never commit
.env
.env.*
!.env.template
# Vite/React dev defaults are non-secret and must be committed so first-time
# checkout does not white-screen on missing VITE_API_URL.
!Seimas.v2/dashboard/.env.development

# OpenPlanter agent sessions (traces often contain API keys — never push)
Seimas.v2/.openplanter/sessions/
OpenPlanter/.openplanter/sessions/

# Optional large workspace (MCP / experiments) — keep local only
openclaw/
.graphiti-mcp/
graphiti-mcp-server/
.antigravity/

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/

# Node
**/node_modules/

# Builds & caches
**/dist/
**/build/
**/.turbo/
**/.next/
**/*.tsbuildinfo

# Logs & runtime
logs/*.log
*.log
npm-debug.log*

# IDE / local
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# OS / tooling
*.orig
.claude/

# One-off artifacts / local scratch (Seimas.v2)
Seimas.v2/tmp_xml/
Seimas.v2/*.png
Seimas.v2/leaderboard.json

# Local env backups (may contain credentials)
.env.bak*
