{
  // The gate CI runs. Identical to tsconfig.json except for the exclusions
  // below, which are listed one by one and explained — a gate that quietly
  // widens its own blind spot is not a gate.
  //
  // These three are vendored shadcn/ui adapters. Nothing in the application
  // imports them (asserted by noVendoredUiImports.test.ts, which fails the
  // moment one is imported, so this list cannot silently start hiding real
  // errors). Their type errors are all mismatches against the installed
  // versions of react-day-picker, recharts and react-resizable-panels — real
  // in the sense that the adapters are broken, and unreachable in the sense
  // that no rendered surface uses them. Fixing them is a separate piece of
  // work; blocking every future type gate on it is not.
  "extends": "./tsconfig.json",
  "exclude": [
    "src/components/ui/calendar.tsx",
    "src/components/ui/chart.tsx",
    "src/components/ui/resizable.tsx"
  ]
}
