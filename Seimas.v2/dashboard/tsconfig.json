{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* `@testing-library/jest-dom/vitest` augments vitest's Assertion
       interface with toBeInTheDocument and friends. Without it every matcher
       in every test file was a type error — 67 of the 104 the project carried,
       which buried the 37 that were real. Declared here rather than relying on
       the setup file: setup.js is JavaScript, so its imports do not put type
       augmentation into the program. */
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
